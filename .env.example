# Local dry runs only. Leave values empty in git.
# The daily workflow reads these from the snapshot-publish environment.
CWA_API_KEY=
# Optional. Leave empty until the KKBOX developer terms are confirmed; songs stay unavailable.
KKBOX_CLIENT_ID=
KKBOX_CLIENT_SECRET=
SNAPSHOT_SIGNING_KEY_HEX=
SNAPSHOT_SIGNING_KEY_ID=
# Scheduled runs set this to 1 in the workflow. Local runs may set 0 to skip signing.
SNAPSHOT_REQUIRE_SIGNATURE=0
