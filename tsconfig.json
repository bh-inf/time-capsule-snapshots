{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "paths": {
      "@time-capsule/schema": ["./packages/schema/src/index.ts"],
      "@time-capsule/snapshot": ["./packages/snapshot/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "pipeline/*/src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
